											}
										},
										"messages": {
											"type": "array",
											"items": {
												"type": "string"
											}
										},
										"result": {
											"type": "object",
											"enum": [null],
											"nullable": true
										},
										"success": {
											"type": "boolean",
											"enum": [false]
										}
									},
									"required": ["success", "messages", "errors", "result"]
								}
							}
						}
					},
					"404": {
