<Window x:Class="BDOLootTracker.Views.WhatsNewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="What's New"
        Width="620"
        Height="570"
        MinWidth="540"
        MinHeight="460"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        Background="{StaticResource Bg}"
        Foreground="{StaticResource Text}"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="*" />
            <RowDefinition Height="14" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Image Source="/Resources/HeaderLogo.png"
                   Width="44" Height="44"
                   Stretch="Uniform" />
            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                <TextBlock x:Name="TitleText"
                           Text="What's New"
                           FontSize="24"
                           FontWeight="SemiBold" />
                <TextBlock x:Name="VersionText"
                           Foreground="{StaticResource Accent}"
                           FontSize="12"
                           Margin="0,3,0,0" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="2"
                Background="{StaticResource Panel}"
                BorderBrush="{StaticResource Border}"
                BorderThickness="1"
                CornerRadius="10"
                Padding="16">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <ItemsControl x:Name="ChangesList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{StaticResource Panel2}"
                                    BorderBrush="{StaticResource Border}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="14"
                                    Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="{Binding Title}"
                                               Foreground="{StaticResource Accent}"
                                               FontWeight="SemiBold"
                                               FontSize="14" />
                                    <TextBlock Text="{Binding Description}"
                                               Foreground="{StaticResource Muted}"
                                               TextWrapping="Wrap"
                                               FontSize="12"
                                               Margin="0,6,0,0" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <Button Grid.Row="4"
                Content="GOT IT"
                HorizontalAlignment="Right"
                MinWidth="110"
                Background="#1266A8"
                FontWeight="SemiBold"
                Click="GotIt_Click" />
    </Grid>
</Window>
