<Window x:Class="BDOLootTracker.Views.SessionHistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Session History"
        Width="1480"
        Height="880"
        MinWidth="1120"
        MinHeight="680"
        Background="{StaticResource Bg}"
        Foreground="{StaticResource Text}"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="3,2,3,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Session History" FontSize="26" FontWeight="SemiBold" />
                <TextBlock Text="Browse sessions by grind spot, review loot, upload to Garmoth, or create a shareable session image."
                           Foreground="{StaticResource Muted}" Margin="0,4,0,0" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <CheckBox x:Name="HideIgnoredCheck"
                          Content="Hide ignored items"
                          IsChecked="True"
                          Foreground="{StaticResource Text}"
                          VerticalAlignment="Center"
                          Margin="0,0,12,0"
                          Checked="FilterChanged"
                          Unchecked="FilterChanged" />
                <Button Content="↻  Refresh" Click="Refresh_Click" />
            </StackPanel>
        </Grid>

        <!-- Selected-filter totals -->
        <Border Grid.Row="1" Style="{StaticResource PanelBorder}" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="#0D151D" CornerRadius="7" Padding="13">
                    <StackPanel>
                        <TextBlock Text="TOTAL SILVER" Foreground="{StaticResource Muted}" FontSize="11" />
                        <TextBlock x:Name="TotalSilverText" Text="—" FontSize="23" FontWeight="SemiBold" Margin="0,5,0,0" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Background="#0D151D" CornerRadius="7" Padding="13">
                    <StackPanel>
                        <TextBlock Text="SILVER / HR" Foreground="{StaticResource Green}" FontSize="11" />
                        <TextBlock x:Name="SilverHrText" Text="—" FontSize="23" FontWeight="SemiBold" Margin="0,5,0,0" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="4" Background="#0D151D" CornerRadius="7" Padding="13">
                    <StackPanel>
                        <TextBlock Text="TRASH / HR" Foreground="{StaticResource Accent}" FontSize="11" />
                        <TextBlock x:Name="TrashHrText" Text="—" FontSize="23" FontWeight="SemiBold" Margin="0,5,0,0" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="6" Background="#0D151D" CornerRadius="7" Padding="13">
                    <StackPanel>
                        <TextBlock Text="TOTAL TIME" Foreground="{StaticResource Muted}" FontSize="11" />
                        <TextBlock x:Name="TotalTimeText" Text="—" FontSize="23" FontWeight="SemiBold" Margin="0,5,0,0" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="270" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Grind spot navigation -->
            <Border Grid.Column="0" Style="{StaticResource PanelBorder}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="GRIND SPOTS" Foreground="{StaticResource Muted}" FontWeight="SemiBold" Margin="15,14,15,10" />
                    <ListBox x:Name="SpotList"
                             Grid.Row="1"
                             Background="Transparent"
                             BorderThickness="0"
                             SelectionChanged="SpotList_SelectionChanged"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.Resources>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Foreground" Value="{StaticResource Text}" />
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="7,1" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6" Padding="10,9">
                                                <ContentPresenter />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="#173047" />
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="#152431" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.Resources>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="1" Text="{Binding Count}" Foreground="{StaticResource Muted}" Margin="10,0,0,0" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- Session cards -->
            <Border Grid.Column="2" Style="{StaticResource PanelBorder}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Margin="16,13">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="SelectedSpotTitleText" Text="All Spots" FontSize="19" FontWeight="SemiBold" />
                            <TextBlock x:Name="SessionCountText" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="10,2,0,0" />
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="Click ▼ to expand a session" Foreground="{StaticResource Muted}" FontSize="11" VerticalAlignment="Center" />
                    </Grid>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="12,0,12,12">
                        <ItemsControl x:Name="SessionCardsControl">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#0D151D"
                                            BorderBrush="{StaticResource Border}"
                                            BorderThickness="1"
                                            CornerRadius="9"
                                            Margin="0,0,0,10"
                                            Padding="14">
                                        <StackPanel>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding HeaderText}" FontSize="15" FontWeight="SemiBold" />
                                                    <TextBlock Text="{Binding SpotText}" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,3,0,0" />
                                                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                                        <TextBlock Text="{Binding SilverHrText}" Foreground="{StaticResource Green}" FontWeight="SemiBold" />
                                                        <TextBlock Text="   •   " Foreground="{StaticResource Muted}" />
                                                        <TextBlock Text="{Binding TrashHrText}" Foreground="{StaticResource Accent}" FontWeight="SemiBold" />
                                                        <TextBlock Text="   •   " Foreground="{StaticResource Muted}" />
                                                        <TextBlock Text="{Binding TotalSilverText}" Foreground="{StaticResource Muted}" />
                                                    </StackPanel>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                                                    <TextBlock Text="{Binding ActivityStatusText}" Foreground="{StaticResource Accent}" FontSize="11" VerticalAlignment="Center" Margin="0,0,10,0" />
                                                    <Button Content="☁  Upload to Garmoth" Height="32" Padding="12,5" Margin="0,0,8,0" Click="UploadSession_Click" />
                                                    <Button Content="▣  Generate Screenshot" Height="32" Padding="12,5" Margin="0,0,8,0" Click="GenerateScreenshot_Click" />
                                                    <Button Content="Delete Session" Height="32" Padding="12,5" Margin="0,0,8,0" Background="#7F1D1D" Click="DeleteSession_Click" />
                                                    <Button Content="{Binding ExpandGlyph}" Width="38" Height="32" Padding="0" Click="ToggleSession_Click" />
                                                </StackPanel>
                                            </Grid>

                                            <Grid Margin="0,12,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <ItemsControl ItemsSource="{Binding PreviewLoot}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <WrapPanel Orientation="Horizontal" />
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Background="#111C26" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="5"
                                                                    Padding="6,4" Margin="0,0,7,5" ToolTip="{Binding Name}">
                                                                <StackPanel Orientation="Horizontal">
                                                                    <Image Source="{Binding IconPath}" Width="24" Height="24" Stretch="Uniform" Margin="0,0,5,0" />
                                                                    <TextBlock Text="{Binding QuantityText}" VerticalAlignment="Center" FontSize="11" FontWeight="SemiBold" />
                                                                </StackPanel>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                <TextBlock Grid.Column="1" Text="{Binding GarmothStatusText}" Foreground="{Binding GarmothStatusBrush}"
                                                           FontSize="11" VerticalAlignment="Center" Margin="10,0,0,0" />
                                            </Grid>

                                            <Border Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVisibility}}"
                                                    BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0" Margin="0,10,0,0" Padding="0,12,0,0">
                                                <StackPanel>
                                                    <Grid Margin="0,0,0,10">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Grid.Column="0">
                                                            <TextBlock Text="DURATION" Foreground="{StaticResource Muted}" FontSize="10" />
                                                            <TextBlock Text="{Binding DurationText}" FontWeight="SemiBold" Margin="0,3,0,0" />
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="1">
                                                            <TextBlock Text="CHARACTER" Foreground="{StaticResource Muted}" FontSize="10" />
                                                            <TextBlock Text="{Binding CharacterText}" FontWeight="SemiBold" Margin="0,3,0,0" />
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="2">
                                                            <TextBlock Text="DROP RATE" Foreground="{StaticResource Muted}" FontSize="10" />
                                                            <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                                                <TextBox Text="{Binding DropRateEditText, UpdateSourceTrigger=PropertyChanged}"
                                                                         Width="64" Height="27" Padding="6,3"
                                                                         HorizontalContentAlignment="Right"
                                                                         ToolTip="Session Drop Rate. Leave empty for unknown." />
                                                                <TextBlock Text="%" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="5,0,0,0" />
                                                                <Button Content="Save" Height="27" Padding="8,2" Margin="8,0,0,0" Click="SaveDropRate_Click" />
                                                            </StackPanel>
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="3">
                                                            <TextBlock Text="GARMOTH" Foreground="{StaticResource Muted}" FontSize="10" />
                                                            <TextBlock Text="{Binding GarmothDetailText}" FontWeight="SemiBold" Margin="0,3,0,0" TextWrapping="Wrap" />
                                                        </StackPanel>
                                                    </Grid>

                                                    <TextBlock Text="FULL LOOT" Foreground="{StaticResource Muted}" FontSize="10" FontWeight="SemiBold" Margin="0,6,0,6" />
                                                    <ItemsControl ItemsSource="{Binding FullLoot}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Grid Margin="0,2">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="38" />
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="115" />
                                                                        <ColumnDefinition Width="130" />
                                                                        <ColumnDefinition Width="130" />
                                                                        <ColumnDefinition Width="80" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <Image Source="{Binding IconPath}" Width="30" Height="30" Stretch="Uniform" />
                                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                                                        <TextBlock Text="{Binding ItemId, StringFormat='ID: {0}'}" Foreground="{StaticResource Muted}" FontSize="10" />
                                                                    </StackPanel>
                                                                    <TextBlock Grid.Column="2" Text="{Binding QuantityText}" VerticalAlignment="Center" />
                                                                    <TextBlock Grid.Column="3" Text="{Binding UnitPriceText}" VerticalAlignment="Center" />
                                                                    <TextBlock Grid.Column="4" Text="{Binding TotalSilverText}" VerticalAlignment="Center" />
                                                                    <Button Grid.Column="5" Content="Ignore" Padding="8,4" FontSize="11"
                                                                            Click="IgnoreItem_Click" />
                                                                </Grid>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>

                                                    <Grid Margin="0,14,0,0">
                                                        <TextBlock Text="{Binding ExpandedInfoText}" Foreground="{StaticResource Muted}" VerticalAlignment="Center" />
                                                    </Grid>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
