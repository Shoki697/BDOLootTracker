<Window x:Class="BDOLootTracker.Views.SessionHistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Session History"
        Width="1220"
        Height="780"
        MinWidth="980"
        MinHeight="620"
        Background="{StaticResource Bg}"
        Foreground="{StaticResource Text}"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="4,2,4,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock Text="Session History" FontSize="24" FontWeight="SemiBold" />
                <TextBlock Text="Previous grind sessions, detailed loot lists, and Ignore List management."
                           Foreground="{StaticResource Muted}"
                           Margin="0,4,0,0" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <CheckBox x:Name="HideIgnoredCheck"
                          Content="Hide ignored items"
                          IsChecked="True"
                          Foreground="{StaticResource Text}"
                          VerticalAlignment="Center"
                          Margin="0,0,12,0"
                          Checked="FilterChanged"
                          Unchecked="FilterChanged" />
                <Button Content="↻  Refresh" Click="Refresh_Click" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="430" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Session list -->
            <Border Grid.Column="0" Style="{StaticResource PanelBorder}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Margin="14,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="SESSIONS" Foreground="{StaticResource Muted}" FontWeight="SemiBold" />
                        <TextBlock x:Name="SessionCountText" Grid.Column="1" Foreground="{StaticResource Muted}" />
                    </Grid>

                    <DataGrid x:Name="SessionGrid"
                              Grid.Row="1"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              RowHeaderWidth="0"
                              RowHeight="48"
                              Background="Transparent"
                              BorderThickness="0"
                              HorizontalGridLinesBrush="{StaticResource Border}"
                              SelectionChanged="SessionGrid_SelectionChanged">
                        <DataGrid.Resources>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#0F1720" />
                                <Setter Property="Foreground" Value="{StaticResource Muted}" />
                                <Setter Property="BorderBrush" Value="{StaticResource Border}" />
                                <Setter Property="Padding" Value="10,8" />
                                <Setter Property="VerticalContentAlignment" Value="Center" />
                            </Style>
                            <Style TargetType="DataGridRow">
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="Foreground" Value="{StaticResource Text}" />
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="#173047" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                            <Style TargetType="DataGridCell">
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="Foreground" Value="{StaticResource Text}" />
                                <Setter Property="BorderThickness" Value="0" />
                                <Setter Property="Padding" Value="10,5" />
                                <Setter Property="VerticalContentAlignment" Value="Center" />
                            </Style>
                        </DataGrid.Resources>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="DATE" Binding="{Binding DateText}" Width="150" />
                            <DataGridTextColumn Header="TIME" Binding="{Binding DurationText}" Width="90" />
                            <DataGridTextColumn Header="SILVER" Binding="{Binding TotalSilverText}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- Details -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource PanelBorder}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock x:Name="DetailTitleText" Text="Select a session" FontSize="20" FontWeight="SemiBold" />
                                <TextBlock x:Name="DetailSubtitleText" Foreground="{StaticResource Muted}" Margin="0,4,0,0" />
                            </StackPanel>
                            <TextBlock x:Name="DetailStatusText" Grid.Column="1" Foreground="{StaticResource Accent}" VerticalAlignment="Center" />
                        </Grid>

                        <Grid Grid.Row="1" Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Background="#0D151D" CornerRadius="6" Padding="12">
                                <StackPanel>
                                    <TextBlock Text="DURATION" Foreground="{StaticResource Muted}" FontSize="11" />
                                    <TextBlock x:Name="DetailDurationText" Text="—" FontSize="20" FontWeight="SemiBold" Margin="0,5,0,0" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" Background="#0D151D" CornerRadius="6" Padding="12">
                                <StackPanel>
                                    <TextBlock Text="TOTAL SILVER" Foreground="{StaticResource Green}" FontSize="11" />
                                    <TextBlock x:Name="DetailTotalSilverText" Text="—" FontSize="20" FontWeight="SemiBold" Margin="0,5,0,0" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="4" Background="#0D151D" CornerRadius="6" Padding="12">
                                <StackPanel>
                                    <TextBlock Text="SILVER / HR" Foreground="{StaticResource Green}" FontSize="11" />
                                    <TextBlock x:Name="DetailSilverHrText" Text="—" FontSize="20" FontWeight="SemiBold" Margin="0,5,0,0" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="6" Background="#0D151D" CornerRadius="6" Padding="12">
                                <StackPanel>
                                    <TextBlock Text="TRASH / HR" Foreground="{StaticResource Accent}" FontSize="11" />
                                    <TextBlock x:Name="DetailTrashHrText" Text="—" FontSize="20" FontWeight="SemiBold" Margin="0,5,0,0" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>
                </Border>

                <Border Grid.Row="2" Style="{StaticResource PanelBorder}" Padding="0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="SESSION LOOT" Foreground="{StaticResource Muted}" FontWeight="SemiBold" Margin="14,12" />

                        <DataGrid x:Name="LootGrid"
                                  Grid.Row="1"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal"
                                  RowHeaderWidth="0"
                                  RowHeight="50"
                                  Background="Transparent"
                                  BorderThickness="0"
                                  HorizontalGridLinesBrush="{StaticResource Border}">
                            <DataGrid.Resources>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="#0F1720" />
                                    <Setter Property="Foreground" Value="{StaticResource Muted}" />
                                    <Setter Property="BorderBrush" Value="{StaticResource Border}" />
                                    <Setter Property="Padding" Value="10,8" />
                                    <Setter Property="VerticalContentAlignment" Value="Center" />
                                </Style>
                                <Style TargetType="DataGridRow">
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="Foreground" Value="{StaticResource Text}" />
                                </Style>
                                <Style TargetType="DataGridCell">
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="Foreground" Value="{StaticResource Text}" />
                                    <Setter Property="BorderThickness" Value="0" />
                                    <Setter Property="Padding" Value="10,5" />
                                    <Setter Property="VerticalContentAlignment" Value="Center" />
                                </Style>
                            </DataGrid.Resources>

                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="ITEM" Width="*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Border Width="34" Height="34" CornerRadius="4" Background="#0A1118" Margin="0,0,9,0">
                                                    <Image Source="{Binding IconPath}" Width="32" Height="32" Stretch="Uniform" />
                                                </Border>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                                    <TextBlock Text="{Binding ItemId, StringFormat='ID: {0}'}" Foreground="{StaticResource Muted}" FontSize="11" />
                                                </StackPanel>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="QTY" Binding="{Binding QuantityText}" Width="120" />
                                <DataGridTextColumn Header="SILVER / UNIT" Binding="{Binding UnitPriceText}" Width="145" />
                                <DataGridTextColumn Header="TOTAL SILVER" Binding="{Binding TotalSilverText}" Width="160" />
                                <DataGridTemplateColumn Header="" Width="92">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="Ignore"
                                                    Tag="{Binding ItemId}"
                                                    Click="IgnoreItem_Click"
                                                    Padding="10,5"
                                                    FontSize="12" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>

                <Grid Grid.Row="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="InfoText"
                               Foreground="{StaticResource Muted}"
                               VerticalAlignment="Center" />

                    <Button x:Name="UploadGarmothButton"
                            Grid.Column="1"
                            Content="☁  Upload to Garmoth"
                            IsEnabled="False"
                            Click="UploadToGarmoth_Click" />

                    <Button Grid.Column="3"
                            Content="Delete Session"
                            Background="#7F1D1D"
                            Click="DeleteSession_Click" />
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>
