<Window x:Class="BDOLootTracker.Views.ParserRecoveryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Loot Parser Recovery"
        Width="520"
        Height="310"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#091118"
        Foreground="#E8F0F6">
    <Window.Resources>
        <SolidColorBrush x:Key="Border" Color="#223544" />
        <SolidColorBrush x:Key="Muted" Color="#91A4B4" />
        <Style TargetType="Button">
            <Setter Property="Background" Value="#14212B" />
            <Setter Property="Foreground" Value="#E8F0F6" />
            <Setter Property="BorderBrush" Value="#2A4355" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="Margin" Value="6,0,0,0" />
        </Style>
    </Window.Resources>

    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal">
            <TextBlock Text="⚠"
                       FontSize="28"
                       Foreground="#FBBF24"
                       VerticalAlignment="Center"
                       Margin="0,0,12,0" />
            <StackPanel>
                <TextBlock Text="Loot parser may be outdated"
                           FontSize="18"
                           FontWeight="SemiBold" />
                <TextBlock x:Name="ProfileText"
                           Foreground="{StaticResource Muted}"
                           FontSize="11"
                           Margin="0,4,0,0" />
            </StackPanel>
        </StackPanel>

        <Border Grid.Row="1"
                Margin="0,18,0,0"
                Padding="14"
                Background="#0D171F"
                BorderBrush="{StaticResource Border}"
                BorderThickness="1"
                CornerRadius="7">
            <TextBlock x:Name="MessageText"
                       TextWrapping="Wrap"
                       LineHeight="20" />
        </Border>

        <TextBlock Grid.Row="2"
                   Text="Auto Repair only downloads signed-by-hash JSON parser data from the configured GitHub repository. If a patch changed the protocol more substantially, Diagnostics can detect a newer packet sample and a new parser profile may still be required."
                   Foreground="{StaticResource Muted}"
                   TextWrapping="Wrap"
                   FontSize="11"
                   Margin="0,14,0,0" />

        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,18,0,0">
            <Button Content="Later" Click="Later_Click" />
            <Button Content="Diagnostics" Click="Diagnostics_Click" />
            <Button Content="Auto Repair"
                    Background="#1266A8"
                    FontWeight="SemiBold"
                    Click="AutoRepair_Click" />
        </StackPanel>
    </Grid>
</Window>
