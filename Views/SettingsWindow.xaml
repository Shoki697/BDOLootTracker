<Window x:Class="BDOLootTracker.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings"
        Width="700"
        Height="780"
        MinHeight="650"
        ResizeMode="CanResize"
        Background="{StaticResource Bg}"
        Foreground="{StaticResource Text}"
        WindowStartupLocation="CenterOwner">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Background="{StaticResource Bg}">
        <StackPanel Margin="20">
            <TextBlock Text="Settings" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,18" />

            <!-- NETWORK -->
            <Border Style="{StaticResource PanelBorder}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="NETWORK" Foreground="{StaticResource Accent}" FontWeight="SemiBold" />
                    <TextBlock Text="Network Adapter" Foreground="{StaticResource Muted}" Margin="0,14,0,6" />
                    <ComboBox x:Name="AdapterCombo"
                              DisplayMemberPath="Description"
                              SelectedValuePath="Name" />
                    <Button x:Name="RefreshAdaptersButton" Content="Refresh adapters"
                            Click="RefreshAdapters_Click"
                            Margin="0,10,0,0"
                            HorizontalAlignment="Left" />
                </StackPanel>
            </Border>

            <!-- DATABASE + MARKET -->
            <Border Style="{StaticResource PanelBorder}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="DATABASE &amp; LOOT DATA"
                               Foreground="{StaticResource Accent}"
                               FontWeight="SemiBold" />

                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Loot / Price Server" Foreground="{StaticResource Muted}" Margin="0,0,0,6" />
                            <ComboBox x:Name="RegionCombo"
                                      SelectionChanged="DatabaseOption_Changed" />
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Item name language" Foreground="{StaticResource Muted}" Margin="0,0,0,6" />
                            <ComboBox x:Name="LanguageCombo"
                                      DisplayMemberPath="Name"
                                      SelectedValuePath="Code"
                                      SelectionChanged="DatabaseOption_Changed" />
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="Database path"
                               Foreground="{StaticResource Muted}"
                               Margin="0,14,0,6" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBox x:Name="DatabasePathBox"
                                 Grid.Column="0"
                                 LostFocus="DatabasePathBox_LostFocus" />
                        <Button x:Name="BrowseButton" Grid.Column="2"
                                Content="Browse"
                                Click="BrowseDatabase_Click" />
                    </Grid>

                    <Border Background="#0D151D"
                            BorderBrush="{StaticResource Border}"
                            BorderThickness="1"
                            CornerRadius="5"
                            Padding="12"
                            Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock x:Name="DatabaseStatusText"
                                       Text="Database status..."
                                       Foreground="{StaticResource Text}"
                                       TextWrapping="Wrap" />
                            <TextBlock x:Name="DatabaseDetailsText"
                                       Foreground="{StaticResource Muted}"
                                       FontSize="12"
                                       Margin="0,5,0,0"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <Button x:Name="FetchButton"
                            Content="↻  FETCH / UPDATE DATABASE"
                            Background="#1266A8"
                            FontWeight="SemiBold"
                            Margin="0,12,0,0"
                            Click="FetchDatabase_Click" />

                    <ProgressBar x:Name="FetchProgressBar"
                                 Height="8"
                                 Minimum="0"
                                 Maximum="100"
                                 Value="0"
                                 Margin="0,10,0,0" />

                    <TextBlock x:Name="FetchStatusText"
                               Foreground="{StaticResource Muted}"
                               FontSize="12"
                               Margin="0,7,0,0"
                               Text="Item names come from the local catalog; grind loot prices/trash flags come from Garmoth. Icons are downloaded only when a new loot item is seen." 
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!-- CHARACTER -->
            <Border Style="{StaticResource PanelBorder}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="CHARACTER (OPTIONAL)"
                               Foreground="{StaticResource Accent}"
                               FontWeight="SemiBold" />

                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="36*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="28*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="36*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Class"
                                       Foreground="{StaticResource Muted}"
                                       Margin="0,0,0,6" />
                            <ComboBox x:Name="ClassCombo"
                                      SelectionChanged="ClassCombo_SelectionChanged">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Grid Width="28" Height="28" Margin="0,0,8,0">
                                                <Border Background="#0D151D"
                                                        BorderBrush="{StaticResource Border}"
                                                        BorderThickness="1"
                                                        CornerRadius="5" />
                                                <TextBlock Text="{Binding Initials}"
                                                           FontSize="10"
                                                           FontWeight="SemiBold"
                                                           Foreground="{StaticResource Muted}"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center" />
                                                <Image Source="{Binding IconPath}"
                                                       Width="26"
                                                       Height="26"
                                                       Stretch="Uniform">
                                                    <Image.Style>
                                                        <Style TargetType="Image">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding HasIcon}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Image.Style>
                                                </Image>
                                            </Grid>
                                            <TextBlock Text="{Binding Name}"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Spec"
                                       Foreground="{StaticResource Muted}"
                                       Margin="0,0,0,6" />
                            <ComboBox x:Name="SpecCombo" />
                        </StackPanel>

                        <StackPanel Grid.Column="4">
                            <TextBlock Text="Character name"
                                       Foreground="{StaticResource Muted}"
                                       Margin="0,0,0,6" />
                            <TextBox x:Name="CharacterBox" />
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="Class, spec, and character name are stored with each session for reference."
                               Foreground="{StaticResource Muted}"
                               FontSize="12"
                               Margin="0,8,0,0" />
                </StackPanel>
            </Border>

            <!-- GARMOTH -->
            <Border Style="{StaticResource PanelBorder}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="GARMOTH"
                               Foreground="{StaticResource Accent}"
                               FontWeight="SemiBold" />

                    <TextBlock Text="API token"
                               Foreground="{StaticResource Muted}"
                               Margin="0,14,0,6" />

                    <PasswordBox x:Name="GarmothApiKeyBox" />

                    <TextBlock Text="Used only when you explicitly upload a completed session from Session History. The token is stored locally in this app's settings file."
                               Foreground="{StaticResource Muted}"
                               FontSize="12"
                               TextWrapping="Wrap"
                               Margin="0,8,0,0" />
                </StackPanel>
            </Border>

            <!-- IGNORE LIST -->
            <Border Style="{StaticResource PanelBorder}" Margin="0,0,0,16">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="IGNORE LIST" Foreground="{StaticResource Accent}" FontWeight="SemiBold" />
                        <TextBlock x:Name="IgnoreCountText" Grid.Column="1" Foreground="{StaticResource Muted}" />
                    </Grid>

                    <TextBlock Text="Item IDs listed here are completely ignored by the live tracker. Existing session data is not deleted."
                               Foreground="{StaticResource Muted}"
                               FontSize="12"
                               TextWrapping="Wrap"
                               Margin="0,10,0,8" />

                    <ListBox x:Name="IgnoreListBox"
                             DisplayMemberPath="DisplayText"
                             Height="120"
                             Background="#0D151D"
                             Foreground="{StaticResource Text}"
                             BorderBrush="{StaticResource Border}"
                             BorderThickness="1" />

                    <Button x:Name="RemoveIgnoreButton"
                            Content="Remove selected from Ignore List"
                            HorizontalAlignment="Left"
                            Margin="0,10,0,0"
                            Click="RemoveSelectedIgnore_Click" />
                </StackPanel>
            </Border>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Button x:Name="SaveButton"
                        Grid.Column="0"
                        Content="Save"
                        Background="#1266A8"
                        Click="Save_Click" />
                <Button x:Name="CancelButton"
                        Grid.Column="2"
                        Content="Cancel"
                        Click="Cancel_Click" />
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Window>
