<Window x:Class="BDOLootTracker.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings"
        Width="900"
        Height="780"
        MinWidth="790"
        MinHeight="650"
        ResizeMode="CanResize"
        Background="{StaticResource Bg}"
        Foreground="{StaticResource Text}"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <Style x:Key="SettingsTabButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource Muted}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0,0,0,2" />
            <Setter Property="Padding" Value="11,10,11,9" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="TabBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource Text}" />
                                <Setter TargetName="TabBorder" Property="Background" Value="{StaticResource PanelHover}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="TabBorder" Property="Opacity" Value="0.72" />
                            </Trigger>
                            <Trigger Property="Tag" Value="Active">
                                <Setter Property="Foreground" Value="{StaticResource Text}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="{StaticResource Accent}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="TabBorder" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Background="{StaticResource Bg}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Settings"
                   FontSize="24"
                   FontWeight="SemiBold"
                   Margin="20,20,20,14" />

        <!-- TABS -->
        <Border Grid.Row="1"
                Margin="20,0,20,0"
                BorderBrush="{StaticResource Border}"
                BorderThickness="0,0,0,1">
            <WrapPanel x:Name="SettingsTabPanel">
                <Button x:Name="NetworkTabButton"
                        Style="{StaticResource SettingsTabButtonStyle}"
                        Tag="Active"
                        CommandParameter="NetworkSection"
                        Content="Network"
                        Click="SettingsTab_Click" />
                <Button x:Name="DatabaseTabButton"
                        Style="{StaticResource SettingsTabButtonStyle}"
                        CommandParameter="DatabaseSection"
                        Content="Database &amp; Loot"
                        Click="SettingsTab_Click" />
                <Button x:Name="CharacterTabButton"
                        Style="{StaticResource SettingsTabButtonStyle}"
                        CommandParameter="CharacterSection"
                        Content="Character"
                        Click="SettingsTab_Click" />
                <Button x:Name="GarmothTabButton"
                        Style="{StaticResource SettingsTabButtonStyle}"
                        CommandParameter="GarmothSection"
                        Content="Garmoth"
                        Click="SettingsTab_Click" />
                <Button x:Name="OverlayTabButton"
                        Style="{StaticResource SettingsTabButtonStyle}"
                        CommandParameter="OverlaySection"
                        Content="Overlay"
                        Click="SettingsTab_Click" />
                <Button x:Name="KeybindsTabButton"
                        Style="{StaticResource SettingsTabButtonStyle}"
                        CommandParameter="KeybindsSection"
                        Content="Keybinds"
                        Click="SettingsTab_Click" />
                <Button x:Name="IgnoreTabButton"
                        Style="{StaticResource SettingsTabButtonStyle}"
                        CommandParameter="IgnoreSection"
                        Content="Ignore List"
                        Click="SettingsTab_Click" />
            </WrapPanel>
        </Border>

        <!-- Only the active tab is visible; controls remain alive so unsaved edits survive tab changes. -->
        <ScrollViewer x:Name="SettingsScrollViewer"
                      Grid.Row="2"
                      Margin="20,16,20,0"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Background="{StaticResource Bg}">
            <StackPanel x:Name="SettingsContentPanel">
                    <!-- NETWORK -->
                    <Border x:Name="NetworkSection" Style="{StaticResource PanelBorder}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="NETWORK" Foreground="{StaticResource Accent}" FontWeight="SemiBold" />
                    <TextBlock Text="Network Adapter" Foreground="{StaticResource Muted}" Margin="0,14,0,6" />
                    <ComboBox x:Name="AdapterCombo"
                              DisplayMemberPath="Description"
                              SelectedValuePath="Name" />
                    <Button x:Name="RefreshAdaptersButton" Content="Refresh adapters"
                            Click="RefreshAdapters_Click"
                            Margin="0,10,0,0"
                            HorizontalAlignment="Left" />

                    <Border Margin="0,18,0,0"
                            Padding="14"
                            Background="#0D151D"
                            BorderBrush="{StaticResource Border}"
                            BorderThickness="1"
                            CornerRadius="7">
                        <StackPanel>
                            <TextBlock Text="EXITLAG COMPATIBILITY"
                                       Foreground="{StaticResource Muted}"
                                       FontSize="11"
                                       FontWeight="SemiBold" />
                            <CheckBox x:Name="ExitLagModeCheckBox"
                                      Content="Enable ExitLag mode"
                                      Margin="0,9,0,0" />
                            <TextBlock Text="Use this only when Black Desert is routed through ExitLag. The tracker dynamically discovers a valid BDO relay instead of requiring TCP port 8889, locks one relay to prevent duplicate loot, and automatically fails over if that relay stops receiving traffic. Start tracking shortly before grinding and wait for the relay-connected status."
                                       Foreground="{StaticResource Muted}"
                                       FontSize="10"
                                       TextWrapping="Wrap"
                                       Margin="0,7,0,0" />
                            <TextBlock x:Name="CaptureDiagnosticsText"
                                       Text="Last capture: no packet data yet."
                                       Foreground="{StaticResource Muted}"
                                       FontSize="10"
                                       TextWrapping="Wrap"
                                       Margin="0,9,0,0" />
                        </StackPanel>
                    </Border>

                    <Border Margin="0,12,0,0"
                            Padding="14"
                            Background="#0D151D"
                            BorderBrush="{StaticResource Border}"
                            BorderThickness="1"
                            CornerRadius="7">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Row="0" Grid.Column="0">
                                <TextBlock Text="NPCAP"
                                           Foreground="{StaticResource Muted}"
                                           FontSize="11"
                                           FontWeight="SemiBold" />
                                <TextBlock x:Name="NpcapStatusText"
                                           Text="Checking..."
                                           FontWeight="SemiBold"
                                           Margin="0,5,0,0" />
                            </StackPanel>

                            <Button x:Name="RecheckNpcapButton"
                                    Grid.Row="0"
                                    Grid.Column="1"
                                    Content="Recheck"
                                    VerticalAlignment="Center"
                                    Click="RecheckNpcap_Click" />

                            <TextBlock x:Name="NpcapDetailsText"
                                       Grid.Row="1"
                                       Grid.ColumnSpan="2"
                                       Foreground="{StaticResource Muted}"
                                       FontSize="11"
                                       TextWrapping="Wrap"
                                       Margin="0,8,0,0" />

                            <TextBlock Grid.Row="2"
                                       Grid.ColumnSpan="2"
                                       Text="Npcap is required for packet capture. The status above also verifies that SharpPcap can see capture adapters."
                                       Foreground="{StaticResource Muted}"
                                       FontSize="10"
                                       TextWrapping="Wrap"
                                       Margin="0,8,0,0" />
                        </Grid>
                    </Border>

                    <Border Margin="0,12,0,0"
                            Padding="14"
                            Background="#0D151D"
                            BorderBrush="{StaticResource Border}"
                            BorderThickness="1"
                            CornerRadius="7">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="LOOT PARSER"
                                               Foreground="{StaticResource Muted}"
                                               FontSize="11"
                                               FontWeight="SemiBold" />
                                    <TextBlock x:Name="ParserStatusText"
                                               Text="Local profile loaded"
                                               FontWeight="SemiBold"
                                               Margin="0,5,0,0" />
                                </StackPanel>

                                <TextBlock x:Name="ParserHealthDot"
                                           Grid.Column="1"
                                           Text="●"
                                           Foreground="#22C55E"
                                           FontSize="16"
                                           VerticalAlignment="Center" />
                            </Grid>

                            <TextBlock x:Name="ParserDetailsText"
                                       Foreground="{StaticResource Muted}"
                                       FontSize="11"
                                       TextWrapping="Wrap"
                                       Margin="0,8,0,0" />

                            <WrapPanel Margin="0,12,0,0">
                                <Button x:Name="ParserDiagnosticsButton"
                                        Content="Diagnostics"
                                        Margin="0,0,8,8"
                                        Click="ParserDiagnostics_Click" />
                                <Button x:Name="ParserCheckUpdateButton"
                                        Content="Check for parser update"
                                        Margin="0,0,8,8"
                                        Click="ParserCheckUpdate_Click" />
                                <Button x:Name="ParserAutoRepairButton"
                                        Content="Auto Repair"
                                        Margin="0,0,0,8"
                                        Background="#1266A8"
                                        Click="ParserAutoRepair_Click" />
                            </WrapPanel>

                            <TextBlock Text="Parser checks do not run when the application simply starts. Remote checks happen only when a session is started or when you use the buttons above."
                                       Foreground="{StaticResource Muted}"
                                       FontSize="10"
                                       TextWrapping="Wrap"
                                       Margin="0,2,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

                    <!-- DATABASE + MARKET -->
                    <Border x:Name="DatabaseSection" Visibility="Collapsed" Style="{StaticResource PanelBorder}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="DATABASE &amp; LOOT DATA"
                               Foreground="{StaticResource Accent}"
                               FontWeight="SemiBold" />

                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Loot / Price Server" Foreground="{StaticResource Muted}" Margin="0,0,0,6" />
                            <ComboBox x:Name="RegionCombo"
                                      SelectionChanged="DatabaseOption_Changed" />
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Item name language" Foreground="{StaticResource Muted}" Margin="0,0,0,6" />
                            <ComboBox x:Name="LanguageCombo"
                                      DisplayMemberPath="Name"
                                      SelectedValuePath="Code"
                                      SelectionChanged="DatabaseOption_Changed" />
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="Database path"
                               Foreground="{StaticResource Muted}"
                               Margin="0,14,0,6" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBox x:Name="DatabasePathBox"
                                 Grid.Column="0"
                                 LostFocus="DatabasePathBox_LostFocus" />
                        <Button x:Name="BrowseButton" Grid.Column="2"
                                Content="Browse"
                                Click="BrowseDatabase_Click" />
                    </Grid>

                    <Border Background="#0D151D"
                            BorderBrush="{StaticResource Border}"
                            BorderThickness="1"
                            CornerRadius="5"
                            Padding="12"
                            Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock x:Name="DatabaseStatusText"
                                       Text="Database status..."
                                       Foreground="{StaticResource Text}"
                                       TextWrapping="Wrap" />
                            <TextBlock x:Name="DatabaseDetailsText"
                                       Foreground="{StaticResource Muted}"
                                       FontSize="12"
                                       Margin="0,5,0,0"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <Button x:Name="FetchButton"
                            Content="↻  FETCH / UPDATE DATABASE"
                            Background="#1266A8"
                            FontWeight="SemiBold"
                            Margin="0,12,0,0"
                            Click="FetchDatabase_Click" />

                    <ProgressBar x:Name="FetchProgressBar"
                                 Height="8"
                                 Minimum="0"
                                 Maximum="100"
                                 Value="0"
                                 Margin="0,10,0,0" />

                    <TextBlock x:Name="FetchStatusText"
                               Foreground="{StaticResource Muted}"
                               FontSize="12"
                               Margin="0,7,0,0"
                               Text="Item names come from the local catalog; grind loot prices/trash flags come from Garmoth. Icons are downloaded only when a new loot item is seen." 
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>

                    <!-- CHARACTER -->
                    <Border x:Name="CharacterSection" Visibility="Collapsed" Style="{StaticResource PanelBorder}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="CHARACTER (OPTIONAL)"
                               Foreground="{StaticResource Accent}"
                               FontWeight="SemiBold" />

                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="36*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="28*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="36*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Class"
                                       Foreground="{StaticResource Muted}"
                                       Margin="0,0,0,6" />
                            <ComboBox x:Name="ClassCombo"
                                      SelectionChanged="ClassCombo_SelectionChanged">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Grid Width="28" Height="28" Margin="0,0,8,0">
                                                <Border Background="#0D151D"
                                                        BorderBrush="{StaticResource Border}"
                                                        BorderThickness="1"
                                                        CornerRadius="5" />
                                                <TextBlock Text="{Binding Initials}"
                                                           FontSize="10"
                                                           FontWeight="SemiBold"
                                                           Foreground="{StaticResource Muted}"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center" />
                                                <Image Source="{Binding IconPath}"
                                                       Width="26"
                                                       Height="26"
                                                       Stretch="Uniform">
                                                    <Image.Style>
                                                        <Style TargetType="Image">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding HasIcon}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Image.Style>
                                                </Image>
                                            </Grid>
                                            <TextBlock Text="{Binding Name}"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Spec"
                                       Foreground="{StaticResource Muted}"
                                       Margin="0,0,0,6" />
                            <ComboBox x:Name="SpecCombo" />
                        </StackPanel>

                        <StackPanel Grid.Column="4">
                            <TextBlock Text="Character name"
                                       Foreground="{StaticResource Muted}"
                                       Margin="0,0,0,6" />
                            <TextBox x:Name="CharacterBox" />
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="Class, spec, and character name are stored with each session for reference."
                               Foreground="{StaticResource Muted}"
                               FontSize="12"
                               Margin="0,8,0,0" />
                </StackPanel>
            </Border>

                    <!-- GARMOTH -->
                    <Border x:Name="GarmothSection" Visibility="Collapsed" Style="{StaticResource PanelBorder}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="GARMOTH"
                               Foreground="{StaticResource Accent}"
                               FontWeight="SemiBold" />

                    <TextBlock Text="API token"
                               Foreground="{StaticResource Muted}"
                               Margin="0,14,0,6" />

                    <PasswordBox x:Name="GarmothApiKeyBox" />

                    <TextBlock Text="Used only when you explicitly upload a completed session from the main window or Session History. The token is stored locally in this app's settings file."
                               Foreground="{StaticResource Muted}"
                               FontSize="12"
                               TextWrapping="Wrap"
                               Margin="0,8,0,0" />

                    <Border Height="1" Background="{StaticResource Border}" Margin="0,16,0,14" />

                    <CheckBox x:Name="GarmothOnlyLootCheckBox"
                              Content="Show and track only loot items known by Garmoth" />
                    <TextBlock Text="When enabled, packet items that are not present in the locally cached Garmoth grind-spot drop list are ignored. Disable it to track every detected loot item."
                               Foreground="{StaticResource Muted}"
                               FontSize="11"
                               TextWrapping="Wrap"
                               Margin="24,6,0,0" />
                </StackPanel>
            </Border>


                    <!-- OVERLAY -->
                    <Border x:Name="OverlaySection" Visibility="Collapsed" Style="{StaticResource PanelBorder}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="OVERLAY"
                               Foreground="{StaticResource Accent}"
                               FontWeight="SemiBold" />

                    <TextBlock Text="Optional in-game session overlay. Turn it on/off from the main window. Mouse clicks always pass through it during normal use."
                               Foreground="{StaticResource Muted}"
                               FontSize="12"
                               TextWrapping="Wrap"
                               Margin="0,8,0,0" />

                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Overlay mode"
                                       Foreground="{StaticResource Muted}"
                                       Margin="0,0,0,6" />
                            <ComboBox x:Name="OverlayModeCombo" />
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Maximum displayed items"
                                       Foreground="{StaticResource Muted}"
                                       Margin="0,0,0,6" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="34" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="OverlayMaxItemsBox"
                                         Grid.Column="0"
                                         HorizontalContentAlignment="Center"
                                         PreviewTextInput="OverlayMaxItemsBox_PreviewTextInput"
                                         LostFocus="OverlayMaxItemsBox_LostFocus" />
                                <Grid Grid.Column="1" Margin="4,0,0,0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <Button Grid.Row="0" Content="▲" Padding="0" FontSize="9" Click="OverlayMaxItemsUp_Click" />
                                    <Button Grid.Row="1" Content="▼" Padding="0" FontSize="9" Click="OverlayMaxItemsDown_Click" />
                                </Grid>
                            </Grid>
                            <TextBlock Text="1–20 • Detailed mode only"
                                       Foreground="{StaticResource Muted}"
                                       FontSize="10"
                                       Margin="0,4,0,0" />
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Loot list sort by"
                                       Foreground="{StaticResource Muted}"
                                       Margin="0,0,0,6" />
                            <ComboBox x:Name="OverlaySortByCombo" />
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Sort order"
                                       Foreground="{StaticResource Muted}"
                                       Margin="0,0,0,6" />
                            <ComboBox x:Name="OverlaySortOrderCombo" />
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="Sorting applies to both the main-screen Loot List and the in-game overlay."
                               Foreground="{StaticResource Muted}"
                               FontSize="10"
                               TextWrapping="Wrap"
                               Margin="0,6,0,0" />

                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Background opacity"
                                   Foreground="{StaticResource Muted}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,12,0" />
                        <Slider x:Name="OverlayOpacitySlider"
                                Grid.Column="1"
                                Minimum="10"
                                Maximum="100"
                                TickFrequency="5"
                                ValueChanged="OverlayOpacitySlider_ValueChanged"
                                VerticalAlignment="Center" />
                        <TextBlock x:Name="OverlayOpacityValueText"
                                   Grid.Column="2"
                                   Width="48"
                                   TextAlignment="Right"
                                   Foreground="{StaticResource Text}"
                                   VerticalAlignment="Center"
                                   Margin="10,0,0,0" />
                    </Grid>

                    <Grid Margin="0,14,0,0" HorizontalAlignment="Left">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="MoveOverlayButton"
                                Grid.Column="0"
                                Content="MOVE OVERLAY"
                                Background="#1266A8"
                                FontWeight="SemiBold"
                                Click="MoveOverlay_Click" />
                        <Button x:Name="ResetOverlayPositionButton"
                                Grid.Column="2"
                                Content="RESET POSITION"
                                Click="ResetOverlayPosition_Click" />
                    </Grid>

                    <TextBlock Text="Move mode temporarily disables click-through. Drag the green header to move, resize from the bottom-right corner, then press Save."
                               Foreground="{StaticResource Muted}"
                               FontSize="11"
                               TextWrapping="Wrap"
                               Margin="0,8,0,0" />
                </StackPanel>
            </Border>

                    <!-- KEYBINDS -->
                    <Border x:Name="KeybindsSection" Visibility="Collapsed" Style="{StaticResource PanelBorder}" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="KEYBINDS"
                                       Foreground="{StaticResource Accent}"
                                       FontWeight="SemiBold" />

                            <TextBlock Text="Optional global shortcuts. They work while BDO is focused and while the tracker is hidden in the system tray. Click a field, then press the desired key combination. Backspace, Delete or Escape clears it."
                                       Foreground="{StaticResource Muted}"
                                       FontSize="12"
                                       TextWrapping="Wrap"
                                       Margin="0,8,0,0" />

                            <Grid Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="190" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Start / Stop Tracking"
                                           Foreground="{StaticResource Muted}"
                                           VerticalAlignment="Center" />
                                <TextBox x:Name="StartStopHotkeyBox"
                                         Grid.Column="1"
                                         IsReadOnly="True"
                                         HorizontalContentAlignment="Center"
                                         PreviewKeyDown="HotkeyBox_PreviewKeyDown" />
                                <Button x:Name="ClearStartStopHotkeyButton"
                                        Grid.Column="3"
                                        Content="Clear"
                                        Click="ClearStartStopHotkey_Click" />
                            </Grid>

                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="190" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Toggle Overlay"
                                           Foreground="{StaticResource Muted}"
                                           VerticalAlignment="Center" />
                                <TextBox x:Name="OverlayHotkeyBox"
                                         Grid.Column="1"
                                         IsReadOnly="True"
                                         HorizontalContentAlignment="Center"
                                         PreviewKeyDown="HotkeyBox_PreviewKeyDown" />
                                <Button x:Name="ClearOverlayHotkeyButton"
                                        Grid.Column="3"
                                        Content="Clear"
                                        Click="ClearOverlayHotkey_Click" />
                            </Grid>

                            <TextBlock Text="Tip: function keys (F1–F24) can be used alone. Other keys require Ctrl, Alt, Shift or Win to avoid taking over normal typing."
                                       Foreground="{StaticResource Muted}"
                                       FontSize="10"
                                       TextWrapping="Wrap"
                                       Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- IGNORE LIST -->
                    <Border x:Name="IgnoreSection" Visibility="Collapsed" Style="{StaticResource PanelBorder}" Margin="0,0,0,16">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="IGNORE LIST" Foreground="{StaticResource Accent}" FontWeight="SemiBold" />
                        <TextBlock x:Name="IgnoreCountText" Grid.Column="1" Foreground="{StaticResource Muted}" />
                    </Grid>

                    <TextBlock Text="Item IDs listed here are completely ignored by the live tracker. Existing session data is not deleted."
                               Foreground="{StaticResource Muted}"
                               FontSize="12"
                               TextWrapping="Wrap"
                               Margin="0,10,0,8" />

                    <ListBox x:Name="IgnoreListBox"
                             DisplayMemberPath="DisplayText"
                             Height="120"
                             Background="#0D151D"
                             Foreground="{StaticResource Text}"
                             BorderBrush="{StaticResource Border}"
                             BorderThickness="1" />

                    <Button x:Name="RemoveIgnoreButton"
                            Content="Remove selected from Ignore List"
                            HorizontalAlignment="Left"
                            Margin="0,10,0,0"
                            Click="RemoveSelectedIgnore_Click" />
                </StackPanel>
            </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Fixed action bar: always visible, independent of tab content/scroll position. -->
        <Border Grid.Row="3"
                Background="{StaticResource Panel}"
                BorderBrush="{StaticResource Border}"
                BorderThickness="0,1,0,0"
                Padding="20,13,20,17"
                Margin="0,14,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="UnsavedChangesText"
                           Grid.Column="0"
                           Text="Unsaved changes"
                           Foreground="{StaticResource Muted}"
                           VerticalAlignment="Center"
                           Visibility="Collapsed" />

                <Button x:Name="CancelButton"
                        Grid.Column="1"
                        Content="Cancel"
                        MinWidth="96"
                        Click="Cancel_Click" />
                <Button x:Name="SaveButton"
                        Grid.Column="3"
                        Content="Save Changes"
                        MinWidth="128"
                        Background="#1266A8"
                        IsEnabled="False"
                        Click="Save_Click" />
            </Grid>
        </Border>
    </Grid>
</Window>
