<Window x:Class="BDOLootTracker.Views.AppDialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="520"
        SizeToContent="Height"
        MaxHeight="680"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <Border Background="{StaticResource Bg}"
            BorderBrush="{StaticResource Border}"
            BorderThickness="1"
            CornerRadius="12"
            Padding="0">
        <Border.Effect>
            <DropShadowEffect BlurRadius="22" ShadowDepth="0" Opacity="0.45" Color="#000000" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Background="#0F1720" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="TitleText"
                           Margin="18,14"
                           FontSize="17"
                           FontWeight="SemiBold" />
                <Button Grid.Column="1"
                        Content="×"
                        Width="38"
                        Height="34"
                        Padding="0"
                        Margin="0,7,8,7"
                        Background="Transparent"
                        BorderThickness="0"
                        FontSize="20"
                        Click="Close_Click" />
            </Grid>

            <Grid Grid.Row="1" Margin="20,22,20,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="54" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Width="40" Height="40" CornerRadius="20"
                        Background="#142433"
                        BorderBrush="{StaticResource Border}"
                        BorderThickness="1"
                        VerticalAlignment="Top">
                    <TextBlock x:Name="IconText"
                               Text="i"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontSize="21"
                               FontWeight="Bold"
                               Foreground="{StaticResource Accent}" />
                </Border>

                <ScrollViewer Grid.Column="1" MaxHeight="420" VerticalScrollBarVisibility="Auto">
                    <TextBlock x:Name="MessageText"
                               TextWrapping="Wrap"
                               FontSize="14"
                               LineHeight="21" />
                </ScrollViewer>
            </Grid>

            <Grid Grid.Row="2" Margin="20,8,20,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="HintText"
                           Foreground="{StaticResource Muted}"
                           FontSize="11"
                           VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="CancelButton" Content="Cancel" Margin="0,0,8,0" Visibility="Collapsed" Click="CancelButton_Click" />
                    <Button x:Name="NoButton" Content="No" Margin="0,0,8,0" Visibility="Collapsed" Click="NoButton_Click" />
                    <Button x:Name="YesButton" Content="Yes" Margin="0,0,8,0" Visibility="Collapsed" Background="#1266A8" Click="YesButton_Click" />
                    <Button x:Name="OkButton" Content="OK" Visibility="Collapsed" Background="#1266A8" MinWidth="88" Click="OkButton_Click" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
