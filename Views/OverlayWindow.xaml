<Window x:Class="BDOLootTracker.Views.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BDO Loot Tracker Overlay"
        Width="390"
        Height="540"
        MinWidth="280"
        MinHeight="120"
        MaxWidth="1000"
        MaxHeight="1200"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Topmost="True">
    <Grid x:Name="WindowRoot">
        <!-- Everything inside this Viewbox scales together when the overlay is resized. -->
        <Viewbox Stretch="Uniform" StretchDirection="Both">
            <Grid>
                <!-- ================================================== -->
                <!-- MODE 1: DETAILED                                  -->
                <!-- ================================================== -->
                <Border x:Name="DetailedDesign"
                        Width="380"
                        Height="500"
                        CornerRadius="10"
                        BorderBrush="#7A2E7A91"
                        BorderThickness="1"
                        Padding="14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="10" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="10" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="{Binding HeaderSpotText}"
                                           Foreground="{StaticResource Accent}"
                                           FontWeight="SemiBold"
                                           FontSize="12"
                                           TextTrimming="CharacterEllipsis"
                                           MaxWidth="190" />
                                <TextBlock Text="  •  " Foreground="{StaticResource Muted}" FontSize="11" />
                                <TextBlock Text="{Binding HeaderClassText}"
                                           Foreground="{StaticResource Text}"
                                           FontWeight="SemiBold"
                                           FontSize="12"
                                           TextTrimming="CharacterEllipsis"
                                           MaxWidth="145" />
                            </StackPanel>
                            <Border Grid.Column="1"
                                    Background="#2A16A56C"
                                    BorderBrush="#661FD589"
                                    BorderThickness="1"
                                    CornerRadius="7"
                                    Padding="7,2"
                                    Margin="8,0,0,0">
                                <TextBlock Text="LIVE" Foreground="#42E89B" FontSize="9" FontWeight="Bold" />
                            </Border>
                        </Grid>

                        <Grid Grid.Row="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="8" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3"
                                    Background="#3514212C"
                                    BorderBrush="#4D294557"
                                    BorderThickness="1"
                                    CornerRadius="7"
                                    Padding="12,9">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="SESSION TIME" Foreground="{StaticResource Muted}" FontSize="10" />
                                        <TextBlock Text="{Binding SessionTimeText}" Foreground="White" FontSize="27" FontWeight="SemiBold" Margin="0,3,0,0" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                        <TextBlock Text="TOTAL SILVER" Foreground="{StaticResource Green}" FontSize="10" HorizontalAlignment="Right" />
                                        <TextBlock Text="{Binding TotalSilverText}" Foreground="White" FontSize="22" FontWeight="SemiBold" Margin="0,6,0,0" HorizontalAlignment="Right" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Border Grid.Row="2" Grid.Column="0"
                                    Background="#3514212C"
                                    BorderBrush="#4D294557"
                                    BorderThickness="1"
                                    CornerRadius="7"
                                    Padding="10,8">
                                <StackPanel>
                                    <TextBlock Text="SILVER / HR" Foreground="{StaticResource Green}" FontSize="9" />
                                    <TextBlock Text="{Binding SilverPerHourText}" Foreground="White" FontSize="17" FontWeight="SemiBold" Margin="0,3,0,0" />
                                </StackPanel>
                            </Border>

                            <Border Grid.Row="2" Grid.Column="2"
                                    Background="#3514212C"
                                    BorderBrush="#4D294557"
                                    BorderThickness="1"
                                    CornerRadius="7"
                                    Padding="10,8">
                                <StackPanel>
                                    <TextBlock Text="TRASH / HR" Foreground="{StaticResource Accent}" FontSize="9" />
                                    <TextBlock Text="{Binding TrashPerHourText}" Foreground="White" FontSize="17" FontWeight="SemiBold" Margin="0,3,0,0" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Border Grid.Row="4"
                                Background="#2A0E171F"
                                BorderBrush="#4D294557"
                                BorderThickness="1"
                                CornerRadius="7"
                                Padding="8,4">
                            <ItemsControl ItemsSource="{Binding OverlayLootRows}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Height="34" Margin="0,1">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="28" />
                                                <ColumnDefinition Width="8" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Border Width="28" Height="28" CornerRadius="4" Background="#66060A0E" VerticalAlignment="Center">
                                                <Image Source="{Binding IconPath}" Width="26" Height="26" Stretch="Uniform" />
                                            </Border>
                                            <TextBlock Grid.Column="2"
                                                       Text="{Binding Name}"
                                                       Foreground="White"
                                                       FontSize="11"
                                                       VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="3"
                                                       Text="{Binding QuantityText}"
                                                       Foreground="#42E89B"
                                                       FontSize="11"
                                                       FontWeight="SemiBold"
                                                       VerticalAlignment="Center"
                                                       Margin="10,0,2,0" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>
                    </Grid>
                </Border>

                <!-- ================================================== -->
                <!-- MODE 2: COMPACT                                   -->
                <!-- ================================================== -->
                <Border x:Name="CompactDesign"
                        Width="380"
                        Height="150"
                        CornerRadius="10"
                        BorderBrush="#7A2E7A91"
                        BorderThickness="1"
                        Padding="13"
                        Visibility="Collapsed">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="8" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Orientation="Horizontal">
                            <TextBlock Text="{Binding HeaderSpotText}"
                                       Foreground="{StaticResource Accent}"
                                       FontWeight="SemiBold"
                                       FontSize="11"
                                       TextTrimming="CharacterEllipsis"
                                       MaxWidth="190" />
                            <TextBlock Text="  •  " Foreground="{StaticResource Muted}" FontSize="10" />
                            <TextBlock Text="{Binding HeaderClassText}"
                                       Foreground="{StaticResource Text}"
                                       FontWeight="SemiBold"
                                       FontSize="11"
                                       TextTrimming="CharacterEllipsis"
                                       MaxWidth="145" />
                        </StackPanel>

                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Grid.Column="0">
                                <TextBlock Text="{Binding SessionTimeText}" Foreground="White" FontSize="25" FontWeight="SemiBold" />
                            </StackPanel>
                            <StackPanel Grid.Row="0" Grid.Column="1" HorizontalAlignment="Right">
                                <TextBlock Text="TOTAL SILVER" Foreground="{StaticResource Green}" FontSize="9" HorizontalAlignment="Right" />
                                <TextBlock Text="{Binding TotalSilverText}" Foreground="White" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Right" />
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="0" VerticalAlignment="Bottom">
                                <TextBlock Text="SILVER / HR" Foreground="{StaticResource Green}" FontSize="9" />
                                <TextBlock Text="{Binding SilverPerHourText}" Foreground="White" FontSize="14" FontWeight="SemiBold" />
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                                <TextBlock Text="TRASH / HR" Foreground="{StaticResource Accent}" FontSize="9" HorizontalAlignment="Right" />
                                <TextBlock Text="{Binding TrashPerHourText}" Foreground="White" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Right" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Viewbox>

        <!-- Placement / resize mode. Click-through is disabled only while this layer is visible. -->
        <Border x:Name="EditChrome"
                Visibility="Collapsed"
                BorderBrush="#38E88B"
                BorderThickness="3"
                CornerRadius="10"
                Background="#1900C86F">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="36" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="48" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Background="#D91A7D4E"
                        MouseLeftButtonDown="DragHandle_MouseLeftButtonDown"
                        Cursor="SizeAll">
                    <TextBlock Text="MOVE OVERLAY — DRAG HERE"
                               Foreground="White"
                               FontSize="12"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Border>

                <TextBlock Grid.Row="1"
                           Text="OVERLAY"
                           Foreground="#CFFFFFFF"
                           FontSize="32"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           IsHitTestVisible="False" />

                <StackPanel Grid.Row="2"
                            Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <Button Content="SAVE"
                            Background="#168A45"
                            Width="92"
                            Margin="0,0,8,0"
                            Click="SavePlacement_Click" />
                    <Button Content="CANCEL"
                            Background="#8F2D2D"
                            Width="92"
                            Click="CancelPlacement_Click" />
                </StackPanel>

                <Thumb x:Name="ResizeThumb"
                       Grid.Row="0"
                       Grid.RowSpan="3"
                       Panel.ZIndex="20"
                       Width="34"
                       Height="34"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Bottom"
                       Margin="0,0,4,4"
                       Cursor="SizeNWSE"
                       DragDelta="ResizeThumb_DragDelta">
                    <Thumb.Template>
                        <ControlTemplate TargetType="Thumb">
                            <Border Background="#EE38E88B"
                                    BorderBrush="#FFFFFFFF"
                                    BorderThickness="1"
                                    CornerRadius="6">
                                <TextBlock Text="◢"
                                           Foreground="White"
                                           FontSize="19"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Border>
                        </ControlTemplate>
                    </Thumb.Template>
                </Thumb>
            </Grid>
        </Border>
    </Grid>
</Window>
