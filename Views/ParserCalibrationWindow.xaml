<Window x:Class="BDOLootTracker.Views.ParserCalibrationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Manual Parser Calibration"
        Width="760"
        Height="700"
        MinWidth="700"
        MinHeight="620"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="{StaticResource Bg}"
        Foreground="{StaticResource Text}">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Manual Calibration"
                       FontSize="22"
                       FontWeight="SemiBold" />
            <TextBlock Text="Guided weekly-patch repair. No full packet capture is saved. Calibration is uploaded only if all three steps pass, it differs from the official parser, and you choose Submit Calibration."
                       Foreground="{StaticResource Muted}"
                       TextWrapping="Wrap"
                       Margin="0,5,0,0" />
        </StackPanel>

        <Border Grid.Row="1"
                Margin="0,16,0,0"
                Padding="12"
                Background="#0D151D"
                BorderBrush="{StaticResource Border}"
                BorderThickness="1"
                CornerRadius="7">
            <StackPanel>
                <TextBlock x:Name="ActiveProfileText"
                           FontWeight="SemiBold" />
                <TextBlock x:Name="LiveStatusText"
                           Foreground="{StaticResource Muted}"
                           FontSize="11"
                           TextWrapping="Wrap"
                           Margin="0,5,0,0" />
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="2"
                      Margin="0,14,0,0"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Padding="14"
                        Background="{StaticResource Panel}"
                        BorderBrush="{StaticResource Border}"
                        BorderThickness="1"
                        CornerRadius="8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="1. MOB LOOT"
                                       Foreground="{StaticResource Accent}"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="Start capture, kill several normal monsters and collect at least 5–10 loot events. Then return here and stop/analyze the capture. The tracker looks for a repeated known-item layout and can rediscover the signature, port and item/quantity offsets."
                                       Foreground="{StaticResource Muted}"
                                       TextWrapping="Wrap"
                                       Margin="0,6,18,0" />
                            <TextBlock x:Name="MobStatusText"
                                       Text="Not calibrated"
                                       Foreground="#FBBF24"
                                       FontSize="11"
                                       Margin="0,8,0,0" />
                        </StackPanel>
                        <Button x:Name="MobCaptureButton"
                                Grid.Column="1"
                                Content="Start capture"
                                MinWidth="132"
                                VerticalAlignment="Center"
                                Click="MobCapture_Click" />
                    </Grid>
                </Border>

                <Border Padding="14"
                        Margin="0,10,0,0"
                        Background="{StaticResource Panel}"
                        BorderBrush="{StaticResource Border}"
                        BorderThickness="1"
                        CornerRadius="8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="2. STORAGE"
                                       Foreground="{StaticResource Accent}"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="Start capture, open Storage with a Maid and withdraw exactly Black Stone ×100. Wait 2–3 seconds, then stop/analyze. Do not perform other inventory transfers during this short capture."
                                       Foreground="{StaticResource Muted}"
                                       TextWrapping="Wrap"
                                       Margin="0,6,18,0" />
                            <TextBlock x:Name="StorageStatusText"
                                       Text="Not calibrated"
                                       Foreground="#FBBF24"
                                       FontSize="11"
                                       Margin="0,8,0,0" />
                        </StackPanel>
                        <Button x:Name="StorageCaptureButton"
                                Grid.Column="1"
                                Content="Start capture"
                                IsEnabled="False"
                                MinWidth="132"
                                VerticalAlignment="Center"
                                Click="StorageCapture_Click" />
                    </Grid>
                </Border>

                <Border Padding="14"
                        Margin="0,10,0,0"
                        Background="{StaticResource Panel}"
                        BorderBrush="{StaticResource Border}"
                        BorderThickness="1"
                        CornerRadius="8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="3. MARKET"
                                       Foreground="{StaticResource Accent}"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="Start capture, open Central Market Warehouse with a Maid and withdraw exactly Black Stone ×100. Wait 2–3 seconds, then stop/analyze. This learns the non-loot Market transfer marker."
                                       Foreground="{StaticResource Muted}"
                                       TextWrapping="Wrap"
                                       Margin="0,6,18,0" />
                            <TextBlock x:Name="MarketStatusText"
                                       Text="Not calibrated"
                                       Foreground="#FBBF24"
                                       FontSize="11"
                                       Margin="0,8,0,0" />
                        </StackPanel>
                        <Button x:Name="MarketCaptureButton"
                                Grid.Column="1"
                                Content="Start capture"
                                IsEnabled="False"
                                MinWidth="132"
                                VerticalAlignment="Center"
                                Click="MarketCapture_Click" />
                    </Grid>
                </Border>

                <Border Margin="0,12,0,0"
                        Padding="12"
                        Background="#0D151D"
                        BorderBrush="{StaticResource Border}"
                        BorderThickness="1"
                        CornerRadius="7">
                    <TextBlock Text="A locally calibrated profile is kept separate from the GitHub profile. A later approved GitHub parser can replace it, and Roll Back restores the last-known-good profile if calibration behaves unexpectedly."
                               Foreground="{StaticResource Muted}"
                               FontSize="11"
                               TextWrapping="Wrap" />
                </Border>

                <Border x:Name="OfficialComparisonBorder"
                        Visibility="Collapsed"
                        Margin="0,10,0,0"
                        Padding="12"
                        Background="#0D151D"
                        BorderBrush="{StaticResource Border}"
                        BorderThickness="1"
                        CornerRadius="7">
                    <StackPanel>
                        <TextBlock Text="OFFICIAL PARSER COMPARISON"
                                   Foreground="{StaticResource Accent}"
                                   FontWeight="SemiBold" />
                        <TextBlock x:Name="OfficialComparisonText"
                                   Margin="0,6,0,0"
                                   Foreground="{StaticResource Muted}"
                                   FontSize="11"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="3" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button x:Name="RollbackButton"
                    Grid.Column="0"
                    Content="Roll Back"
                    Click="Rollback_Click" />

            <Button x:Name="SubmitCalibrationButton"
                    Grid.Column="2"
                    Content="Submit Calibration"
                    IsEnabled="False"
                    Margin="0,0,8,0"
                    Click="SubmitCalibration_Click" />

            <Button x:Name="ActivateProfileButton"
                    Grid.Column="3"
                    Content="Activate Local Profile"
                    Background="#1266A8"
                    FontWeight="SemiBold"
                    IsEnabled="False"
                    Margin="0,0,8,0"
                    Click="ActivateProfile_Click" />

            <Button Grid.Column="4"
                    Content="Close"
                    Click="Close_Click" />
        </Grid>
    </Grid>
</Window>
