<Window x:Class="BDOLootTracker.Views.ParserCalibrationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ground Loot Parser Calibration"
        Width="930" Height="610"
        MinWidth="820" MinHeight="560"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource Bg}"
        Foreground="{StaticResource Text}">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Ground Loot Calibration" FontSize="24" FontWeight="SemiBold" />
            <TextBlock Text="Weekly patch repair using normal ground loot only. The Garmoth-only display filter is ignored during calibration. Storage, Market, Maid and other inventory transfers are ignored. If the result differs from official, Submit Calibration sends only parser structure and validation stats to the built-in Community service."
                       Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,5,0,0" />
        </StackPanel>

        <Border Grid.Row="1" Margin="0,16,0,0" Padding="12" Background="#0D151D" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="7">
            <StackPanel>
                <TextBlock x:Name="ActiveProfileText" FontWeight="SemiBold" />
                <TextBlock x:Name="LiveStatusText" Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,5,0,0" />
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="2" Margin="0,14,0,0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Padding="16" Background="{StaticResource Panel}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="8">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="GROUND LOOT" Foreground="{StaticResource Accent}" FontWeight="SemiBold" />
                            <TextBlock Text="Start capture, kill normal monsters and collect 10–20 items from the ground. Do not use Storage, Market, Maid or perform inventory transfers during this short capture. The tracker learns the loot signature, offsets and a ground-loot-only fingerprint."
                                       Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,7,18,0" />
                            <TextBlock x:Name="MobStatusText" Text="Not calibrated" Foreground="#FBBF24" FontSize="11" Margin="0,10,0,0" />
                        </StackPanel>
                        <Button x:Name="MobCaptureButton" Grid.Column="1" Content="Start capture" MinWidth="140" VerticalAlignment="Center" Click="MobCapture_Click" />
                    </Grid>
                </Border>

                <Border Margin="0,12,0,0" Padding="12" Background="#0D151D" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="7">
                    <TextBlock Text="Ground-loot mode is a positive allowlist: only packets matching the calibrated ground-loot fingerprint are counted. Storage, Market, Maid and other inventory transfers are ignored when they do not match the Ground Loot baseline."
                               Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" />
                </Border>

                <Border x:Name="OfficialComparisonBorder" Visibility="Collapsed" Margin="0,10,0,0" Padding="12" Background="#0D151D" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="7">
                    <StackPanel>
                        <TextBlock Text="OFFICIAL PARSER COMPARISON" Foreground="{StaticResource Accent}" FontWeight="SemiBold" />
                        <TextBlock x:Name="OfficialComparisonText" Margin="0,6,0,0" Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="3" Margin="0,16,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Button x:Name="RollbackButton" Grid.Column="0" Content="Roll Back" Click="Rollback_Click" />
            <Button x:Name="SubmitCalibrationButton" Grid.Column="2" Content="Submit Calibration" IsEnabled="False" Margin="0,0,8,0" Click="SubmitCalibration_Click" />
            <Button x:Name="ActivateProfileButton" Grid.Column="3" Content="Activate Local Profile" Background="#1266A8" FontWeight="SemiBold" IsEnabled="False" Margin="0,0,8,0" Click="ActivateProfile_Click" />
            <Button Grid.Column="4" Content="Close" Click="Close_Click" />
        </Grid>
    </Grid>
</Window>
