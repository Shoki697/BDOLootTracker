<Window x:Class="BDOLootTracker.Views.ParserCalibrationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Calibration"
        Width="980" Height="760"
        MinWidth="900" MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Bg}"
        Foreground="{StaticResource Text}">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Calibration" FontSize="27" FontWeight="SemiBold" />
            <TextBlock Text="Guided parser calibration after a BDO maintenance. Complete Grind Loot first, then teach the tracker which Market and Storage transfers must be ignored."
                       Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,5,0,0" />
        </StackPanel>

        <Border Grid.Row="1" Margin="0,16,0,0" Padding="13" Background="#0D151D" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="7">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock x:Name="ActiveProfileText" FontWeight="SemiBold" />
                    <TextBlock x:Name="LiveStatusText" Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,5,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0,0,0">
                    <TextBlock x:Name="GrindTopStatus" Text="○ Grind Loot" Foreground="#FBBF24" FontWeight="SemiBold" Margin="0,0,14,0"/>
                    <TextBlock x:Name="MarketTopStatus" Text="○ Market" Foreground="#94A3B8" FontWeight="SemiBold" Margin="0,0,14,0"/>
                    <TextBlock x:Name="StorageTopStatus" Text="○ Storage" Foreground="#94A3B8" FontWeight="SemiBold"/>
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="2" Margin="0,14,0,0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- GRIND LOOT -->
                <Border Padding="16" Background="{StaticResource Panel}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="8">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="1. GRIND LOOT" Foreground="{StaticResource Accent}" FontWeight="SemiBold" FontSize="15" />
                                <TextBlock Text="Start calibration and kill monsters normally. Do not open Market, Storage, Maid or move inventory items during this step. The capture stops automatically after enough valid ground-loot samples are found."
                                           Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,7,18,0" />
                            </StackPanel>
                            <Button x:Name="GrindCaptureButton" Grid.Column="1" Content="Start Grind Calibration" MinWidth="175" VerticalAlignment="Center" Click="GrindCapture_Click" />
                        </Grid>
                        <ProgressBar x:Name="GrindProgressBar" Height="18" Minimum="0" Maximum="30" Value="0" Margin="0,15,0,0" />
                        <Grid Margin="0,6,0,0">
                            <TextBlock x:Name="GrindStatusText" Text="Not calibrated" Foreground="#FBBF24" FontSize="11" />
                            <TextBlock x:Name="GrindProgressText" Text="0 / 30" HorizontalAlignment="Right" Foreground="{StaticResource Muted}" FontSize="11" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- MARKET -->
                <Border Margin="0,12,0,0" Padding="16" Background="{StaticResource Panel}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="8">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="2. MARKET" Foreground="{StaticResource Accent}" FontWeight="SemiBold" FontSize="15" />
                            <TextBlock Text="Use the same transfer calibration as before. Start capture, withdraw exactly 100 Black Stones from Central Market / Market Storage, wait a moment, then stop and analyze. The learned marker is added to the BLOCK list."
                                       Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,7,18,0" />
                            <TextBlock x:Name="MarketStatusText" Text="Waiting for Grind Loot calibration" Foreground="#94A3B8" FontSize="11" Margin="0,10,0,0" />
                        </StackPanel>
                        <Button x:Name="MarketCaptureButton" Grid.Column="1" Content="Start Market Capture" MinWidth="175" VerticalAlignment="Center" IsEnabled="False" Click="MarketCapture_Click" />
                    </Grid>
                </Border>

                <!-- STORAGE -->
                <Border Margin="0,12,0,0" Padding="16" Background="{StaticResource Panel}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="8">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="3. STORAGE" Foreground="{StaticResource Accent}" FontWeight="SemiBold" FontSize="15" />
                            <TextBlock Text="Start capture, withdraw exactly 100 Black Stones from normal town Storage / Warehouse, wait a moment, then stop and analyze. This marker is also added to the BLOCK list."
                                       Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,7,18,0" />
                            <TextBlock x:Name="StorageStatusText" Text="Waiting for Grind Loot calibration" Foreground="#94A3B8" FontSize="11" Margin="0,10,0,0" />
                        </StackPanel>
                        <Button x:Name="StorageCaptureButton" Grid.Column="1" Content="Start Storage Capture" MinWidth="175" VerticalAlignment="Center" IsEnabled="False" Click="StorageCapture_Click" />
                    </Grid>
                </Border>

                <Border Margin="0,12,0,0" Padding="12" Background="#0D151D" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="7">
                    <TextBlock Text="Runtime priority: Market / Storage BLOCK markers are checked before the calibrated Grind Loot ALLOW fingerprint. A packet identified as a transfer is ignored even if its inventory-add layout also resembles normal loot."
                               Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" />
                </Border>

                <Border x:Name="OfficialComparisonBorder" Visibility="Collapsed" Margin="0,10,0,0" Padding="12" Background="#0D151D" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="7">
                    <StackPanel>
                        <TextBlock Text="OFFICIAL PARSER COMPARISON" Foreground="{StaticResource Accent}" FontWeight="SemiBold" />
                        <TextBlock x:Name="OfficialComparisonText" Margin="0,6,0,0" Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="3" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button x:Name="ResetCalibrationButton" Grid.Column="0" Content="Reset Calibration" Click="ResetCalibration_Click" />
            <Button x:Name="RollbackButton" Grid.Column="1" Content="Roll Back" Margin="8,0,0,0" Click="Rollback_Click" />
            <Button x:Name="SubmitCalibrationButton" Grid.Column="3" Content="Submit Calibration" IsEnabled="False" Margin="0,0,8,0" Click="SubmitCalibration_Click" />
            <Button x:Name="SaveFinishButton" Grid.Column="4" Content="Save &amp; Finish" Background="#1266A8" FontWeight="SemiBold" IsEnabled="False" Margin="0,0,8,0" Click="SaveFinish_Click" />
            <Button Grid.Column="5" Content="Cancel" Click="Cancel_Click" />
        </Grid>
    </Grid>
</Window>
