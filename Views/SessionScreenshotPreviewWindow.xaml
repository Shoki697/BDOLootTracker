<Window x:Class="BDOLootTracker.Views.SessionScreenshotPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Session Screenshot"
        Width="800"
        Height="760"
        MinWidth="650"
        MinHeight="520"
        Background="{StaticResource Bg}"
        Foreground="{StaticResource Text}"
        WindowStyle="None"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Background="#0F1720" MouseLeftButtonDown="Header_MouseLeftButtonDown">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Margin="16,10">
                <TextBlock Text="Session Screenshot" FontSize="16" FontWeight="SemiBold" />
                <TextBlock Text="Preview, copy, or save the generated session card"
                           Foreground="{StaticResource Muted}" FontSize="10" Margin="0,2,0,0" />
            </StackPanel>
            <Button Grid.Column="1" Content="×" Width="38" Height="32" Padding="0" Margin="0,7,7,7"
                    Background="Transparent" BorderThickness="0" FontSize="19" Click="Close_Click" />
        </Grid>

        <Grid Grid.Row="1" Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Style="{StaticResource PanelBorder}" Padding="10">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Auto"
                              CanContentScroll="False">
                    <Border Background="#070C11" Padding="10" CornerRadius="6">
                        <Image x:Name="PreviewImage"
                               Stretch="None"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Top"
                               SnapsToDevicePixels="True" />
                    </Border>
                </ScrollViewer>
            </Border>

            <Grid Grid.Row="1" Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="ImageInfoText" Foreground="{StaticResource Muted}" FontSize="10.5" />
                    <TextBlock x:Name="StatusText" Foreground="{StaticResource Green}" FontSize="10.5" Margin="0,2,0,0" />
                </StackPanel>

                <Button Grid.Column="1" Content="Copy" MinWidth="92" Padding="12,7" Click="Copy_Click" />
                <Button Grid.Column="3" Content="Save As" MinWidth="100" Padding="12,7"
                        Background="#1266A8" FontWeight="SemiBold" Click="SaveAs_Click" />
                <Button Grid.Column="5" Content="Close" MinWidth="92" Padding="12,7" Click="Close_Click" />
            </Grid>
        </Grid>
    </Grid>
</Window>
