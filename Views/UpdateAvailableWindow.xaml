<Window x:Class="BDOLootTracker.Views.UpdateAvailableWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="560"
        SizeToContent="Height"
        MaxHeight="720"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <Border Background="{StaticResource Bg}"
            BorderBrush="{StaticResource Border}"
            BorderThickness="1"
            CornerRadius="12">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="0" Opacity="0.5" Color="#000000" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Background="#0F1720" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Margin="20,15">
                    <TextBlock Text="Update available" FontSize="19" FontWeight="SemiBold" />
                    <TextBlock Text="A newer BDO Loot Tracker version is ready." Foreground="{StaticResource Muted}" Margin="0,3,0,0" />
                </StackPanel>
                <Button Grid.Column="1" Content="×" Width="38" Height="34" Padding="0" Margin="0,8,9,8"
                        Background="Transparent" BorderThickness="0" FontSize="20" Click="Later_Click" />
            </Grid>

            <StackPanel Grid.Row="1" Margin="22,22,22,8">
                <Border Background="#0D151D" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="8" Padding="15">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="18" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="INSTALLED" Foreground="{StaticResource Muted}" FontSize="11" />
                            <TextBlock x:Name="CurrentVersionText" FontSize="22" FontWeight="SemiBold" Margin="0,5,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="AVAILABLE" Foreground="{StaticResource Green}" FontSize="11" />
                            <TextBlock x:Name="NewVersionText" FontSize="22" FontWeight="SemiBold" Margin="0,5,0,0" />
                        </StackPanel>
                    </Grid>
                </Border>

                <TextBlock Text="Release notes" Foreground="{StaticResource Muted}" FontSize="11" FontWeight="SemiBold" Margin="0,18,0,7" />
                <Border Background="#0D151D" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="8" Padding="12">
                    <ScrollViewer MaxHeight="250" VerticalScrollBarVisibility="Auto">
                        <TextBlock x:Name="ReleaseNotesText" TextWrapping="Wrap" LineHeight="20" />
                    </ScrollViewer>
                </Border>

                <TextBlock Text="The application will restart automatically after the update."
                           Foreground="{StaticResource Muted}" FontSize="11" Margin="0,10,0,0" />
            </StackPanel>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="22,12,22,22">
                <Button Content="Later" MinWidth="100" Margin="0,0,10,0" Click="Later_Click" />
                <Button Content="Update now" MinWidth="120" Background="#1266A8" FontWeight="SemiBold" Click="UpdateNow_Click" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
